# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPENAI_API_KEY: Optional but RECOMMENDED. If set, the image-gen pipeline
# uses OpenAI gpt-image-1 as the primary image model — much better label
# spelling (no "ESOHAPUS" / "GALLBALLDER"), better instruction-following, no
# unsolicited answer-marker overlays. On any OpenAI failure (or if unset),
# the system falls back to Gemini's gemini-2.5-flash-image. The Bank's
# per-question card chip shows which provider rendered each image; the Bank
# auto-pings provider health on mount and shows a persistent banner when
# OpenAI is unreachable.
OPENAI_API_KEY="sk-..."

# OPENAI_IMAGE_MODEL: Override the OpenAI image model. Valid values per the
# /v1/images/generations endpoint: gpt-image-1, gpt-image-1-mini,
# gpt-image-1.5, dall-e-2, dall-e-3. (gpt-image-2 is NOT a valid model name
# — sending it returns 404 and silently falls back to Gemini.)
OPENAI_IMAGE_MODEL="gpt-image-1"

# IMAGE_PROVIDER_STRICT: Optional. When "true", an OpenAI failure does NOT
# fall through to Gemini — the error propagates to the UI instead. Use this
# in production bank work where Gemini's label-misspelling failure mode is
# unacceptable. Default: false (silent Gemini fallback preserved so existing
# batches don't break if the OpenAI key is unset or expired).
# IMAGE_PROVIDER_STRICT="true"
